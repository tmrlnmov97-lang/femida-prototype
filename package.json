{
  "name": "femida-prototype",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "npm run dev -w @femida/app",
    "dev:landing": "npm run dev -w @femida/landing",
    "generate": "npm run generate -w @femida/app && npm run generate -w @femida/landing",
    "shot": "node scripts/shot.mjs",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "puppeteer-core": "^23.11.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
